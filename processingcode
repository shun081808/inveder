void draw_player(int x, int y) {
  fill(255);
  stroke(255);
  triangle(x, y-35, x-18, y-20, x+18, y-20);
  rect(x-35, y-20, 70, 20);
}

void enemy(int x, int y, int col) {
  if (col==7) {
    fill(0, 0, 0);
    stroke(0, 0, 0);
  } else {
    fill(50, 175, 255/7*col+10);
    stroke(50, 175, 255/7*col+10);
  }
  ellipse(x, y, 60, 20);
  strokeWeight(5);
  line(x-10, y, x-30, y+20);
  line(x+10, y, x+30, y+20);
  strokeWeight(1);
  fill(0);
  ellipse(x-10, y, 5, 10);
  ellipse(x+10, y, 5, 10);
}


void draw_enemies() {
  check(bx, by);
  for (int h=0; h<6; h++) {
    for (int w=0; w<6; w++) {
      if (enemy_state[w][h]==1) {
        enemy(posx[w][h], posy[w][h], 7);
      } else {   
        enemy(posx[w][h], posy[w][h], h);
      }
    }
  }
}

void move_enemies() {
  for (int h=0; h<6; h++) {
    for (int w=0; w<6; w++) {
      posx[w][h]=posx[w][h]+vx;
      posy[w][h]=posy[w][h]+vy;
    }
  }
  if (posx[1][1]<=170) {
    vx=1;
    vy=100;
  } else if (posx[5][5]>=width-30) {
    vx=-1;
    vy=1;
  } else
    vy=0;
}

void player_atack() {
  if (state==1) {
    fill(255);
    ellipse(bx, by, 10, 10);
    by-=10;
  }
  if (by<=0)
    state=0;
}

int check(int x, int y) {
  int num=6;
  for (int h=0; h<6; h++) {
    for (int w=0; w<6; w++) {
      if (dist(x, y, posx[w][h], posy[w][h] )<=30) {
        enemy_state[w][h]=1;
        num=w;
      }
    }
  }
  return num;
}

void enemy_atack() {     

  if (cy<=0||cy>=height) {
    j=int(random(6));
    k=int(random(6));
    cx=posx[j][k];
    cy=posy[j][k];
  }

  fill(255);
  ellipse(cx, cy, 10, 10);
  cy+=10-k;
}

void shield1(int x, int y) {
  for (int i=0; i<9; i++) {
    for (int j=0; j<9; j++) {
      if (state1[i][j]==1) {
        x1[i][j]=x+20*i;
        y1[i][j]=y+20*j;
        rect(x1[i][j], y1[i][j], 20, 20);
        stroke(0);

        if ((x1[i][j]-10<=bx)&&(bx<=x1[i][j]+10)) {
          if ((y1[i][j]-10<=by)&&(by<=y1[i][j]+10)) {
            state1[i][j]=0;
            by=0;
          }
        }
        if ((x1[i][j]-10<=cx)&&(cx<=x1[i][j]+10)) {
          if ((y1[i][j]-10<=cy)&&(cy<=y1[i][j]+10)) {
            state1[i][j]=0;
            cy=1000;
          }
        }
      }
    }
  }
}
